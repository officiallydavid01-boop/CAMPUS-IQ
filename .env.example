# Copy this file to .env and replace the placeholders with values from
# Supabase Dashboard → Project Settings → API.
# These are the public project URL and publishable key, intended for browser use.
# NEVER put a service_role/secret key in this file or any VITE_* variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
